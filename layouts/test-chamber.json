{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [20, 28],
  "preview": "layouts/test-chamber.svg",
  "theme": "test-chamber",
  "ui_font": "Bahnschrift",
  "terminal_padding": [12, 10],
  "background": "canvas",
  "children": [
    { "id": "bar", "type": "block", "size": { "px": 72 }, "window_drag": true,
      "content": { "mod": "test-chamber", "props": { "role": "bar" } } },
    {
      "id": "middle",
      "type": "row",
      "size": { "weight": 1 },
      "background": { "image": "mods/test-chamber/wall-grid.svg", "fit": "cover" },
      "padding": 12,
      "gap": 12,
      "children": [
        { "id": "side", "type": "block", "size": { "px": 268 }, "min": 200, "max": 440,
          "radius": 6,
          "content": { "mod": "test-chamber", "props": { "role": "side" } } },
        {
          "id": "work-body",
          "type": "row",
          "size": { "weight": 1 },
          "gap": 12,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 12,
                  "radius": 6,
                  "background": "background",
                  "border": { "width": 2, "color": "#3a434b" },
                  "focus": { "width": 3, "color": "#2fa8ff" },
                  "header": { "content": { "mod": "test-chamber" }, "height": 34, "position": "top", "reveal": "always" },
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "size": { "px": 380 },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": "surface",
              "border": { "width": 2, "color": "#3a434b" },
              "radius": 6,
              "padding": 4,
              "children": [
                { "id": "panel-body", "type": "stack", "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ] }
              ]
            }
          ]
        },
        { "id": "gun", "type": "block", "size": { "px": 240 }, "min": 200, "max": 400,
          "radius": 6,
          "content": { "mod": "test-chamber", "props": { "role": "gun" } } }
      ]
    },
    { "id": "hud", "type": "block", "size": { "px": 94 },
      "content": { "mod": "test-chamber", "props": { "role": "hud" } } }
  ]
}
